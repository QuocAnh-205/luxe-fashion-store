server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Thay thế cho proxy '/api' trong vite.config.js (chỉ hoạt động lúc "npm run dev").
    # Khi build production, mọi request /api/... từ frontend sẽ được Nginx
    # chuyển tiếp sang backend thật (BACKEND_URL), y hệt hành vi lúc dev.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cho phép React Router (SPA) hoạt động khi reload trang con
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache tài nguyên tĩnh
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        access_log off;
    }
}